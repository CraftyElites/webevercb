# Copy to .env and fill in real values. Never commit .env

PORT=3000
NODE_ENV=production

# Strong random secret (at least 32 chars). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# SQLite path (relative to project root)
DB_PATH=./data/webever.db

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
DEFAULT_QUOTA_MB=1024

# Optional: rate limit window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
